{
    "openapi": "3.0.0",
    "info": {
        "title": "Minha API",
        "description": "Documentação da API Laravel",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Ambiente local"
        }
    ],
    "paths": {
        "/api/auth/register": {
            "post": {
                "tags": [
                    "Autenticação"
                ],
                "summary": "Cadastrar usuário",
                "operationId": "register",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Maria"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "maria@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "SenhaForte123!"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "SenhaForte123!"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Usuário cadastrado e autenticado"
                    },
                    "422": {
                        "description": "Dados inválidos"
                    }
                }
            }
        },
        "/api/auth/login": {
            "post": {
                "tags": [
                    "Autenticação"
                ],
                "summary": "Entrar na aplicação",
                "operationId": "login",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "maria@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "SenhaForte123!"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login realizado"
                    },
                    "422": {
                        "description": "Credenciais inválidas"
                    }
                }
            }
        },
        "/api/auth/me": {
            "get": {
                "tags": [
                    "Autenticação"
                ],
                "summary": "Obter usuário autenticado",
                "operationId": "currentUser",
                "responses": {
                    "200": {
                        "description": "Usuário autenticado"
                    },
                    "401": {
                        "description": "Não autenticado"
                    }
                }
            }
        },
        "/api/auth/logout": {
            "post": {
                "tags": [
                    "Autenticação"
                ],
                "summary": "Encerrar sessão",
                "operationId": "logout",
                "responses": {
                    "200": {
                        "description": "Logout realizado"
                    },
                    "401": {
                        "description": "Não autenticado"
                    }
                }
            }
        },
        "/api/categorias": {
            "get": {
                "tags": [
                    "Categorias"
                ],
                "summary": "Listar categorias",
                "operationId": "listarCategorias",
                "responses": {
                    "200": {
                        "description": "Lista de categorias com id e nome"
                    },
                    "401": {
                        "description": "Não autenticado"
                    }
                }
            }
        },
        "/api/receitas": {
            "get": {
                "tags": [
                    "Receitas"
                ],
                "summary": "Listar receitas do usuário autenticado",
                "operationId": "listarReceitas",
                "responses": {
                    "200": {
                        "description": "Lista paginada de receitas"
                    },
                    "401": {
                        "description": "Não autenticado"
                    }
                }
            },
            "post": {
                "tags": [
                    "Receitas"
                ],
                "summary": "Cadastrar uma nova receita",
                "operationId": "cadastrarReceita",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "required": [
                                    "categoria_id",
                                    "nome",
                                    "tempo_preparo_minutos",
                                    "porcoes",
                                    "modo_preparo",
                                    "ingredientes"
                                ],
                                "properties": {
                                    "categoria_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "nome": {
                                        "type": "string",
                                        "example": "Bolo de Chocolate"
                                    },
                                    "tempo_preparo_minutos": {
                                        "type": "integer",
                                        "example": 45
                                    },
                                    "porcoes": {
                                        "type": "integer",
                                        "example": 4
                                    },
                                    "modo_preparo": {
                                        "type": "string",
                                        "example": "Misture os ingredientes e asse por 35 minutos."
                                    },
                                    "ingredientes": {
                                        "type": "string",
                                        "example": "Farinha, ovos, açúcar, leite e chocolate."
                                    },
                                    "imagem": {
                                        "type": "string",
                                        "format": "binary"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Receita cadastrada com sucesso"
                    },
                    "401": {
                        "description": "Não autenticado"
                    },
                    "422": {
                        "description": "Erro de validação"
                    }
                }
            }
        },
        "/api/receitas/{receita}": {
            "get": {
                "tags": [
                    "Receitas"
                ],
                "summary": "Obter detalhes de uma receita",
                "operationId": "obterReceita",
                "parameters": [
                    {
                        "name": "receita",
                        "in": "path",
                        "description": "ID da receita",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Detalhes da receita"
                    },
                    "401": {
                        "description": "Não autenticado"
                    },
                    "404": {
                        "description": "Receita não encontrada"
                    }
                }
            },
            "put": {
                "tags": [
                    "Receitas"
                ],
                "summary": "Atualizar uma receita",
                "operationId": "atualizarReceita",
                "parameters": [
                    {
                        "name": "receita",
                        "in": "path",
                        "description": "ID da receita",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "required": [
                                    "categoria_id",
                                    "nome",
                                    "tempo_preparo_minutos",
                                    "porcoes",
                                    "modo_preparo",
                                    "ingredientes"
                                ],
                                "properties": {
                                    "nome": {
                                        "type": "string",
                                        "example": "Bolo de Chocolate"
                                    },
                                    "tempo_preparo_minutos": {
                                        "type": "integer",
                                        "example": 45
                                    },
                                    "porcoes": {
                                        "type": "integer",
                                        "example": 4
                                    },
                                    "modo_preparo": {
                                        "type": "string",
                                        "example": "Misture os ingredientes e asse por 35 minutos."
                                    },
                                    "ingredientes": {
                                        "type": "string",
                                        "example": "Farinha, ovos, açúcar, leite e chocolate."
                                    },
                                    "categoria_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "imagem": {
                                        "type": "string",
                                        "format": "binary"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Receita atualizada com sucesso"
                    },
                    "401": {
                        "description": "Não autenticado"
                    },
                    "404": {
                        "description": "Receita não encontrada"
                    },
                    "422": {
                        "description": "Erro de validação"
                    }
                }
            },
            "delete": {
                "tags": [
                    "Receitas"
                ],
                "summary": "Excluir uma receita",
                "operationId": "excluirReceita",
                "parameters": [
                    {
                        "name": "receita",
                        "in": "path",
                        "description": "ID da receita",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Receita excluída com sucesso"
                    },
                    "401": {
                        "description": "Não autenticado"
                    },
                    "404": {
                        "description": "Receita não encontrada"
                    }
                }
            }
        },
        "/api/receitas/search": {
            "get": {
                "tags": [
                    "Receitas"
                ],
                "summary": "Pesquisar receitas",
                "operationId": "pesquisarReceitas",
                "parameters": [
                    {
                        "name": "nome",
                        "in": "query",
                        "description": "Nome da receita",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "categoria_id",
                        "in": "query",
                        "description": "ID da categoria",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "tempo_maximo",
                        "in": "query",
                        "description": "Tempo máximo de preparo (em minutos)",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Receitas encontradas"
                    },
                    "401": {
                        "description": "Não autenticado"
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Autenticação",
            "description": "Autenticação"
        },
        {
            "name": "Categorias",
            "description": "Categorias"
        },
        {
            "name": "Receitas",
            "description": "Receitas"
        }
    ]
}